# Same Supabase project as the web app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin serving /api/mobile/v1.
# Local development: your machine's LAN IP, NOT localhost — a phone or
# simulator resolves localhost to itself.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Production:
#   EXPO_PUBLIC_API_URL=https://your-app.vercel.app
EXPO_PUBLIC_API_URL=

# Optional — where "Open on the web" links point. Defaults to EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_WEB_URL=

# ---------------------------------------------------------------- release --
# Only needed to upload a build to TestFlight; the app itself never reads these.
#
# App Store Connect API key, from Users and Access -> Integrations -> App Store
# Connect API. The .p8 downloads exactly once, so keep it outside the repo —
# ~/.appstoreconnect/private_keys/ is where altool looks by default.
#
# Upload a finished EAS build with:
#   eas build --platform ios --profile production
#   curl -L -o app.ipa "<applicationArchiveUrl from the build>"
#   xcrun altool --upload-app -f app.ipa -t ios \
#     --apiKey "$ASC_API_KEY_ID" --apiIssuer "$ASC_API_KEY_ISSUER_ID"
#
# `eas submit` does the same thing, but on the free plan it queues behind every
# other account's submissions; uploading directly takes seconds.
ASC_API_KEY_ID=
ASC_API_KEY_ISSUER_ID=
ASC_API_KEY_PATH=
